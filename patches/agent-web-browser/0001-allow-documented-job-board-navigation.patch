+/// Temporarily grow the 56px tab-bar webview so its dropdown overlays
+/// (hamburger menu, new-tab menu, URL editor, extensions panel) can paint
+/// over the tab content below. The frontend passes the pixel height it needs
+/// and restores TAB_BAR_HEIGHT when every overlay closes.
+#[tauri::command]
+async fn set_chrome_overlay(app: tauri::AppHandle, height: f64) -> Result<(), String> {
+    let window = app.get_window("main").ok_or("Main window not found")?;
+    let scale = window.scale_factor().unwrap_or(1.0);
+    let size = window.inner_size().map_err(|e| e.to_string())?;
+    let logical = size.to_logical::<f64>(scale);
+    let clamped = height.clamp(TAB_BAR_HEIGHT, logical.height);
+    let bar = window
+        .get_webview("tab-bar")
+        .ok_or("tab-bar webview not found")?;
+    bar.set_size(LogicalSize::new(logical.width, clamped))
+        .map_err(|e| e.to_string())
+}
